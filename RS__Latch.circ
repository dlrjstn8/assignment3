  <vhdl appearance="logisim_evolution" name="RS_Latch">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
use ieee.std_logic_arith.all;&#13;
use ieee.std_logic_unsigned.all;&#13;
&#13;
entity RS_Latch is&#13;
    port(&#13;
        R :in std_logic;&#13;
        S :in std_logic;&#13;
        Q :out std_logic;&#13;
        not_Q :out std_logic&#13;
    );&#13;
end entity RS_Latch;&#13;
&#13;
architecture bhv of RS_Latch is&#13;
   signal q_reg : std_logic := '0';&#13;
begin&#13;
    process(R, S)&#13;
    begin&#13;
        if (S = '1' and R = '0') then&#13;
            q_reg &lt;= '1';&#13;
        elsif (S = '0' and R = '1') then&#13;
            q_reg &lt;= '0';&#13;
        elsif (S = '0' and R = '0') then&#13;
            null;&#13;
        else&#13;
            q_reg &lt;= 'X';&#13;
        end if;&#13;
    end process;&#13;
&#13;
    Q     &lt;= q_reg;&#13;
    not_Q &lt;= not q_reg;&#13;
end architecture bhv;&#13;
</vhdl>
