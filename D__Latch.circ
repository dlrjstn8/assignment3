  <vhdl appearance="logisim_evolution" name="D_Latch">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
use ieee.std_logic_arith.all;&#13;
use ieee.std_logic_unsigned.all;&#13;
&#13;
entity D_Latch is&#13;
    port(&#13;
        CLK : in std_logic;&#13;
        D : in std_logic;&#13;
        Q : out std_logic&#13;
    );&#13;
end entity D_Latch;&#13;
&#13;
architecture bhv of D_Latch is&#13;
begin&#13;
    process(CLK, D)&#13;
    begin&#13;
        if(CLK = '1') then&#13;
            Q &lt;= D;&#13;
        end if;&#13;
    end process;&#13;
end architecture bhv;&#13;
