    <comp loc="(450,240)" name="D_Flip_Flop_sc"/>
    <wire from="(190,240)" to="(230,240)"/>
    <wire from="(190,260)" to="(230,260)"/>
    <wire from="(190,280)" to="(230,280)"/>
    <wire from="(190,300)" to="(230,300)"/>
